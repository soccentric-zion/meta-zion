software =
{
    version = "@@VERSION@@";
    hardware-compatibility =["1.0"];
    signing = "RSA";

/*
 * Zynq UltraScale+ Kria (KV260 / KR260) — A/B rootfs OTA update
 *
 * Partition layout (meta-zion/wic/sdimage-zynqmp.wks):
 *   p1 /boot  FAT32  BOOT.BIN, Image, system.dtb, boot.scr + A/B markers
 *   p2        ext4   rootfs-a  (active slot)
 *   p3        ext4   rootfs-b  (standby slot)
 *   p4 /home  ext4   persistent data (never touched by OTA)
 *
 * Workflow:
 *   1. pre-install.sh  identifies the inactive slot by partition label,
 *      creates the /dev/swupdate-inactive symlink, and backs up the
 *      shared kernel and DTB (/boot/Image, /boot/system.dtb -> *.prev).
 *   2. The "raw" handler streams rootfs.ext4.gz into the inactive slot.
 *   3. The new Image and system.dtb are written into /boot/.
 *   4. post-install.sh sets the /boot/slot_b marker, drops
 *      /boot/upgrade_pending (arms the U-Boot rollback boot counter in
 *      boot.cmd.zion) and writes /boot/boot_state (tries_remaining=3).
 *   5. SWUpdate reboots via postupdatecmd.
 *
 * On next boot boot.cmd.zion selects the slot from the marker and counts
 * unconfirmed boots. After the apps are healthy swupdate-bootcheck.sh
 * confirms the slot (/boot_ok + confirmed=true); after 3 failed boots the
 * U-Boot script rolls back to the previous slot automatically.
 */

images: (
    {
        filename   = "rootfs.ext4.gz";
        type       = "raw";
        device     = "/dev/swupdate-inactive";
        compressed = "zlib";
    },
    {
        filename = "@@KERNEL@@";
        type     = "rawfile";
        path     = "/boot/@@KERNEL@@";
    },
    {
        filename = "@@DTB@@";
        type     = "rawfile";
        path     = "/boot/@@DTB@@";
    }
);

scripts: (
    {
        filename = "pre-install.sh";
        type     = "shellscript";
        data     = "preinst";
    },
    {
        filename = "post-install.sh";
        type     = "shellscript";
        data     = "postinst";
    }
);
};