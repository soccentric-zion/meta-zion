software =
{
    version = "@@VERSION@@";
    hardware-compatibility =["1.0"];
    signing = "RSA";

/*
 * Zynq UltraScale+ KR260 — A/B rootfs OTA update
 *
 * Workflow:
 *   1. pre-install.sh  identifies the inactive slot, creates
 *      /dev/swupdate-inactive symlink, and backs up current kernel
 *      and DTB to *.prev for rollback.
 *   2. The "raw" handler streams rootfs.ext4.gz → inactive slot.
 *   3. Image and the DTB are written to /boot/.
 *   4. post-install.sh updates /boot/extlinux/extlinux.conf,
 *      writes /boot/boot_state (tries_remaining=3, confirmed=false),
 *      and backs up extlinux.conf.prev.
 *   5. SWUpdate triggers `reboot` via postupdatecmd.
 *   On next boot: boot-watchdog.sh decrements tries_remaining.
 *   After apps are healthy: swupdate-bootcheck.sh writes confirmed=true.
 */

images: (
    {
        filename   = "rootfs.ext4.gz";
        type       = "raw";
        device     = "/dev/swupdate-inactive";
        compressed = "zlib";
    },
    {
        filename = "@@KERNEL@@";
        type     = "rawfile";
        path     = "/boot/@@KERNEL@@";
    },
    {
        filename = "@@DTB@@";
        type     = "rawfile";
        path     = "/boot/@@DTB@@";
    }
);

scripts: (
    {
        filename = "pre-install.sh";
        type     = "shellscript";
        data     = "preinst";
    },
    {
        filename = "post-install.sh";
        type     = "shellscript";
        data     = "postinst";
    }
);
};
